# StudentAI local/production environment template
# Copy this file to .env and replace placeholder values.
# NEVER commit a real API key or production secret.

POSTGRES_DB=studentai
POSTGRES_USER=studentai
POSTGRES_PASSWORD=change-this-database-password

GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=1440

ALLOWED_ORIGINS=http://localhost

# Optional multi-AI providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
